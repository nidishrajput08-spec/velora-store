# Copy to .env.local
# Use your own admin email. Never commit real secrets.
ADMIN_EMAIL=your-email@example.com

# Razorpay - add only on the server/deployment environment
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id

# Add your database/auth provider credentials here when configured.